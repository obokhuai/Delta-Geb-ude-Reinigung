# Public URL of the website (used for SEO: canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.de

# SMTP settings for the contact and quote forms.
# If these are not set, the forms still validate and show visitors
# how to reach the company directly by phone or email instead.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Sender address (must be allowed by your SMTP provider)
CONTACT_FROM="Delta Website <website@example.de>"
# Where form messages are delivered (defaults to the company email in src/config/site.ts)
CONTACT_TO=onyiberecycling@yahoo.com
